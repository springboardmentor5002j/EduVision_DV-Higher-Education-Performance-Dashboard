                              <run bold='true' fontalignment='1' fontcolor='#000000' fontsize='15'>HIGHER EDUCATION PERFORMANCE DASHBOARD</run>
                            </formatted-text>
                          </zone>
                          <zone id='13'>
                            <formatted-text>
                              <run bold='true' fontcolor='#000000' fontsize='11'>PROJECT HIGHLIGHTS</run>
                              <run>Æ&#10;&#10;</run>
                              <run fontsize='11'>Æ                </run>
                              <run fontcolor='#1b1b1b' fontsize='11'>✓ University Performance &amp; Rankings</run>
                              <run>Æ&#10;</run>
                              <run fontcolor='#1b1b1b' fontsize='11'>               ✓ Country &amp; Regional Benchmarking</run>
                              <run>Æ&#10;</run>
                              <run fontcolor='#1b1b1b' fontsize='11'>               ✓ Research Productivity Analysis</run>
                              <run>Æ&#10;</run>
