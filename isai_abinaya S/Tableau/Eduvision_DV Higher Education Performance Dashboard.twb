                      <currentDeltas>
                        <dashboard name='Home'>
                          <zone id='3'>
                            <formatted-text>
                              <run fontcolor='#000000' fontsize='12'>Welcome to the Higher Education Performance Dashboard. This interactive dashboard provides insights into global university rankings, research performance, student diversity, faculty-to-student ratios, and country-level benchmarking. Use the navigation buttons below to explore each analytical section.</run>
                            </formatted-text>
                          </zone>
